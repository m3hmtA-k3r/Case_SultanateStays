<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SultanateStays</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen flex-col bg-white font-[Manrope] text-[#4A5070] antialiased">
    @{
        var activeController = ViewContext.RouteData.Values["controller"]?.ToString();
        string NavClass(string controller) => activeController == controller
        ? "bg-white text-[#3B3FB6] shadow-sm"
        : "text-[#4A5070] hover:text-[#1B2140]";
    }

    <header class="sticky top-0 z-50 bg-[#F5F6FA]/95 backdrop-blur">
        <div class="mx-auto flex h-20 max-w-[1280px] items-center justify-between px-4 sm:px-6">
            <a class="flex items-center gap-3" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo-mark.png" alt="" aria-hidden="true" class="h-10 w-10 object-contain" />
                <span class="text-lg font-extrabold tracking-[-0.03em] text-[#1B2140]">SultanateStays</span>
            </a>

            <nav class="flex items-center gap-1 text-sm font-semibold">
                <a class="rounded-full px-4 py-2 transition @NavClass("Home")" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                <a class="rounded-full px-4 py-2 text-[#4A5070] transition hover:text-[#1B2140]" asp-controller="Home" asp-action="Index" asp-fragment="popular">Popüler Şehirler</a>
                <a class="rounded-full px-4 py-2 transition @NavClass("Hotels")" asp-controller="Hotels" asp-action="Search">Oteller</a>
            </nav>
        </div>
    </header>

    <main class="mx-auto w-full max-w-[1280px] flex-1 px-4 py-10 sm:px-6">
        @RenderBody()
    </main>

    <footer class="mt-16 bg-[#1B2140] text-white/70">
        <div class="mx-auto max-w-[1280px] px-4 py-16 sm:px-6">
            <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
                <div class="max-w-xs">
                    <span class="inline-flex rounded-xl bg-white px-4 py-3">
                        <img src="~/img/logo-transparent.png" alt="Sultanate Stays logosu" class="h-14 w-auto object-contain" />
                    </span>
                    <p class="mt-4 text-sm">Dünyanın saray otelleri, tek arama ile.</p>
                </div>

                <nav class="flex flex-wrap gap-x-8 gap-y-3 font-semibold">
                    <a class="transition hover:text-white" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                    <a class="transition hover:text-white" asp-controller="Hotels" asp-action="Search">Oteller</a>
                </nav>
            </div>

            <div class="mt-12 border-t border-white/10 pt-6 text-sm">
                <span>&copy; 2026 SultanateStays. Tüm hakları saklıdır.</span>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
